# =============================================================================
# Polyagent DevContainer — Configuration (base variant)
# =============================================================================
# Build and startup values for this container.
# See [Configuration](../REFERENCE.md#configuration-devcontainerenv) and [DevContainer lifecycle](../REFERENCE.md#devcontainer-lifecycle).
# =============================================================================

# --- Identity (unique per instance) ---
COMPOSE_PROJECT_NAME=polyagent-devcontainer
CONTAINER_NAME=polyagent-dev
IMAGE_NAME=polyagent-devcontainer
IMAGE_TAG=latest

# --- Runtime ---
TZ=UTC
# Optional: TypeSafe API key for the typesafe-ai skill. Never commit.
TYPESAFE_API_KEY=
# set to your network's DNS server if internal hostnames must resolve
DNS_PRIMARY=

# --- Node.js ---
# For project code (empty = no project Node.js installed)
# Set when the project needs Node.js. Example: PROJECT_NODE_VERSION=20
PROJECT_NODE_VERSION=

# --- Workspace ---
# See [Configuration](../REFERENCE.md#configuration-devcontainerenv).
HOST_WORKSPACE_PATH=
